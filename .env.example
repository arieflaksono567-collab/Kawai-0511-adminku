# KAWAI 0511 ADMIN PANEL — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development.
# In Cloudflare Pages, configure these under Settings > Environment variables.

# Supabase Project URL (Public)
# Production Project Reference: rbfnjgrnojvzvrpyryms
VITE_SUPABASE_URL="https://rbfnjgrnojvzvrpyryms.supabase.co"

# Supabase Anon Key (Public Client Key)
# SAFE to expose in frontend client code. Governed strictly by PostgreSQL Row Level Security (RLS).
# Obtain this from Supabase Dashboard -> Project Settings -> API -> anon public key.
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Application Environment
VITE_APP_ENV="production"
VITE_APP_NAME="KAWAI 0511 Admin Panel"

# Security: Enable/Disable Evaluation Demo Mode
# In production, set to false (or leave unset) so that only authentic Supabase sessions can login.
VITE_ENABLE_DEMO="false"

# ------------------------------------------------------------------------------
# BACKEND (server.ts & Cloudflare Pages Functions) — JANGAN pakai prefix VITE_
# ------------------------------------------------------------------------------
# Daftar origin yang boleh memanggil API lintas domain (pisahkan dengan koma).
# Kosongkan bila API hanya dipanggil dari domain panel ini sendiri.
ALLOWED_ORIGINS=""

# Penyedia jarak jalan untuk tarif: "osrm" atau "none".
ROUTING_PROVIDER="none"
# URL instance OSRM sendiri. Server publik router.project-osrm.org hanya untuk demo.
OSRM_BASE_URL=""

# SECURITY NOTICE:
# DO NOT ADD SUPABASE_SERVICE_ROLE_KEY HERE!
# The service_role key bypasses all Row Level Security and MUST NEVER be bundled into client-side code.
