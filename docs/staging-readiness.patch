diff --git a/server.ts b/server.ts
index da5b3e4..7450bd5 100644
--- a/server.ts
+++ b/server.ts
@@ -168,32 +168,45 @@ async function startServer() {
       let distanceKm: number;
       let routingProviderName: string;
 
-      if (!apiKey || provider === 'none') {
+      if (!provider || provider === 'none') {
         return res.status(503).json({ 
-          error: 'Penyedia routing jalan nyata belum dikonfigurasi (ROUTING_API_KEY / ROUTING_PROVIDER belum disetel pada environment server). Tarif tidak dapat dihitung tanpa jarak jalan nyata.',
+          error: 'Penyedia routing jalan nyata belum dikonfigurasi (ROUTING_PROVIDER belum disetel pada environment server). Tarif tidak dapat dihitung tanpa jarak jalan nyata.',
           code: 'ROUTING_NOT_CONFIGURED' 
         });
       }
 
       if (provider === 'osrm') {
-        const url = `https://router.project-osrm.org/route/v1/driving/${lngP},${latP};${lngD},${latD}?overview=false`;
-        const resp = await fetch(url);
-        if (!resp.ok) {
+        try {
+          const url = `https://router.project-osrm.org/route/v1/driving/${lngP},${latP};${lngD},${latD}?overview=false`;
+          const resp = await fetch(url, { signal: AbortSignal.timeout(8000) });
+          if (!resp.ok) {
+            return res.status(502).json({
+              error: 'Layanan routing gagal mengembalikan jarak jalan nyata.',
+              code: 'ROUTING_FAILED'
+            });
+          }
+          const routingData = await resp.json() as any;
+          if (!routingData.routes || !routingData.routes[0]) {
+            return res.status(422).json({
+              error: 'Tidak ditemukan rute jalan yang dapat dilalui antara titik penjemputan dan tujuan.',
+              code: 'NO_ROUTE_FOUND'
+            });
+          }
+          distanceKm = Number((routingData.routes[0].distance / 1000).toFixed(2));
+          routingProviderName = 'osrm';
+        } catch (routingErr: any) {
           return res.status(502).json({
-            error: 'Layanan routing gagal mengembalikan jarak jalan nyata.',
+            error: `Gagal menghubungi penyedia routing jalan: ${routingErr.message || 'Network / Timeout error'}`,
             code: 'ROUTING_FAILED'
           });
         }
-        const routingData = await resp.json() as any;
-        if (!routingData.routes || !routingData.routes[0]) {
-          return res.status(422).json({
-            error: 'Tidak ditemukan rute jalan yang dapat dilalui antara titik penjemputan dan tujuan.',
-            code: 'NO_ROUTE_FOUND'
+      } else {
+        if (!apiKey) {
+          return res.status(503).json({ 
+            error: `Penyedia routing "${provider}" memerlukan ROUTING_API_KEY yang belum disetel.`,
+            code: 'ROUTING_NOT_CONFIGURED' 
           });
         }
-        distanceKm = Number((routingData.routes[0].distance / 1000).toFixed(2));
-        routingProviderName = 'osrm';
-      } else {
         return res.status(503).json({
           error: `Penyedia routing "${provider}" belum didukung atau memerlukan konfigurasi tambahan.`,
           code: 'UNSUPPORTED_ROUTING_PROVIDER'
diff --git a/src/__tests__/order_creation.test.ts b/src/__tests__/order_creation.test.ts
index ed7df71..2f6f842 100644
--- a/src/__tests__/order_creation.test.ts
+++ b/src/__tests__/order_creation.test.ts
@@ -174,5 +174,30 @@ test('KAWAI 0511 - Order Creation & Tariff Integration Tests', async (t) => {
     assert.ok(serverCode.includes('idempotencyKey'), 'Must handle Idempotency-Key / x-idempotency-key headers');
     assert.ok(serverCode.includes('idempotencyStore'), 'Must maintain idempotency store to prevent duplicate orders');
   });
+
+  await t.test('13. Startup consistency - backend build generates server.js for npm start', () => {
+    const pkgPath = path.resolve('./package.json');
+    const pkgJson = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
+
+    assert.ok(pkgJson.scripts.build.includes('server.js'), 'build script must generate server.js for npm start');
+    assert.strictEqual(pkgJson.scripts.start, 'node server.js', 'start script must invoke node server.js');
+  });
+
+  await t.test('14. Routing error and timeout handling', () => {
+    const serverPath = path.resolve('./server.ts');
+    const serverCode = fs.readFileSync(serverPath, 'utf8');
+
+    assert.ok(serverCode.includes('ROUTING_FAILED'), 'Must handle routing network failure or timeout with ROUTING_FAILED');
+    assert.ok(serverCode.includes('NO_ROUTE_FOUND'), 'Must handle unroutable points with NO_ROUTE_FOUND');
+    assert.ok(serverCode.includes('AbortSignal.timeout'), 'Must enforce timeout on external routing HTTP calls');
+  });
+
+  await t.test('15. Supabase configuration safety - safe rejection when unconfigured', () => {
+    const serverPath = path.resolve('./server.ts');
+    const serverCode = fs.readFileSync(serverPath, 'utf8');
+
+    assert.ok(serverCode.includes('SUPABASE_NOT_CONFIGURED'), 'Must fail safely with SUPABASE_NOT_CONFIGURED when keys/URL are missing');
+  });
 });
 
+
diff --git a/supabase/config.toml b/supabase/config.toml
new file mode 100644
index 0000000..d228419
